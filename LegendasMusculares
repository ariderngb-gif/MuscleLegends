local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local conexionAnimacion = nil

local function interceptarAnimaciones(animator)
	if conexionAnimacion then conexionAnimacion:Disconnect() end
	conexionAnimacion = animator.AnimationPlayed:Connect(function(animationTrack)
		local id = animationTrack.Animation.AnimationId
		if ventajaAutofarmPremium and animacionesBloqueadas[id] then
			animationTrack:Stop(0)
		end
	end)
end

local function getAnimIDString(animationObject)
	if not animationObject then return "" end
	local idStr = tostring(animationObject.AnimationId)
	return idStr:match("%d+$") or ""
end

local function monitorTrack(track)
	local animId = getAnimIDString(track.Animation)
	
	if listaAnimacionesBloqueadasSistema[animId] then
		if ventajaBloqueadorAnimacionesActiva then
			track:Stop(0)
		end
		
		track:GetPropertyChangedSignal("IsPlaying"):Connect(function()
			if ventajaBloqueadorAnimacionesActiva and track.IsPlaying and listaAnimacionesBloqueadasSistema[animId] then
				track:Stop(0)
			end
		end)
	end
end

local function setupAnimationListener(character)
	local humanoidObj = character:WaitForChild("Humanoid", 5)
	if not humanoidObj then return end
	local animator = humanoidObj:WaitForChild("Animator", 5)
	if not animator then return end
	
	animator.AnimationPlayed:Connect(monitorTrack)
	
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		monitorTrack(track)
	end
end

