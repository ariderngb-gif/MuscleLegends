RocaToggleButton.MouseButton1Click:Connect(function()
	ventajaRocaActiva = not ventajaRocaActiva
	
	if ventajaRocaActiva then
		local nombreRoca = listaRocas[indiceRoca]
		local WorkspaceRef = game:GetService("Workspace")
		local folder = WorkspaceRef:FindFirstChild("machinesFolder")
		
		if folder then
			local modeloRoca = folder:FindFirstChild(nombreRoca)
			if modeloRoca then
				rocaObjetoActual = modeloRoca:FindFirstChild("Rock")
			end
		end
		
		if not rocaObjetoActual then
			warn("ARIDER: No se encontró la roca física en el mapa.")
			ventajaRocaActiva = false
			return
		end
		
		posicionOriginal = rocaObjetoActual.CFrame
		tamanoOriginal = rocaObjetoActual.Size
		colisionOriginal = rocaObjetoActual.CanCollide
		transparenciaOriginal = rocaObjetoActual.Transparency
		
		rocaObjetoActual.Transparency = 1
		
		RocaToggleButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		RocaToggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
		RocaToggleButton.Text = "ACTIVADO"
		RocaToggleStroke.Color = Color3.fromRGB(255, 255, 255)
		
		bucleRoca = RunService.RenderStepped:Connect(function()
			local char = player.Character
			if char and rocaObjetoActual then
				local mIzquierda = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
				local mDerecha = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
				
				if mIzquierda and mDerecha then
					local centro = (mIzquierda.Position + mDerecha.Position) / 2
					local distancia = (mIzquierda.Position - mDerecha.Position).Magnitude
					
					rocaObjetoActual.CanCollide = false
					rocaObjetoActual.Anchored = true
					rocaObjetoActual.CFrame = CFrame.new(centro)
					
					local escala = distancia * 0.8
					rocaObjetoActual.Size = Vector3.new(escala, escala, escala)
				end
			end
		end)
	else
		RocaToggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		RocaToggleButton.TextColor3 = Color3.fromRGB(150, 150, 150)
		RocaToggleButton.Text = "DESACTIVADO"
		RocaToggleStroke.Color = Color3.fromRGB(80, 80, 80)
		
		if bucleRoca then
			bucleRoca:Disconnect()
			bucleRoca = nil
		end
		
		local rocaPorRestaurar = rocaObjetoActual
		local posOriginal = posicionOriginal
		local tamOriginal = tamanoOriginal
		local colOriginal = colisionOriginal
		local transOriginal = transparenciaOriginal
		
		rocaObjetoActual = nil
		
		task.spawn(function()
			if rocaPorRestaurar and posOriginal then
				local tiempoInicio = tick()
				local conexionSeguridad
				conexionSeguridad = RunService.RenderStepped:Connect(function()
					if tick() - tiempoInicio < 3 then
						rocaPorRestaurar.CFrame = posOriginal
						rocaPorRestaurar.Size = tamOriginal
						rocaPorRestaurar.CanCollide = colOriginal
						rocaPorRestaurar.Transparency = transOriginal
					else
						conexionSeguridad:Disconnect()
					end
				end)
			end
		end)
	end
end)

